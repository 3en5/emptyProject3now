# ─── זיהוי חכם של מסמכים (אופציונלי) ───
# מפתח API של Anthropic — מפעיל את שכבת ה-Claude שקוראת מסמכים סרוקים ובעברית.
# בלי מפתח: המערכת עובדת עם זיהוי כללים מקומי בלבד (חינם, טוב ל-PDF דיגיטלי מוכר).
# להשגת מפתח: https://console.anthropic.com  →  Settings  →  API Keys
# שימוש: העתיקו קובץ זה ל-.env ומלאו את המפתח (הקובץ .env לא נכנס ל-git).
ANTHROPIC_API_KEY=

# אופציונלי — עקיפת המודל/המאמץ (ברירת מחדל: opus 4.8 במאמץ נמוך, חסכוני):
# FINANCE_CLAUDE_MODEL=claude-opus-4-8
# FINANCE_CLAUDE_EFFORT=low
